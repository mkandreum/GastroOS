# GastrOS - variables de entorno

# URL pública de la app. Se usa para generar los QR firmados de las mesas.
APP_URL="http://localhost:3000"

# client | internal | both
APP_TYPE="both"

PORT=3000

# Obligatorio en producción. Cadena aleatoria de 32+ caracteres.
# Genera una con: openssl rand -base64 48
JWT_SECRET=""

# Secreto independiente para los QR de mesa. Si se deja vacío se deriva de JWT_SECRET.
# Cambiarlo invalida todos los QR impresos.
TABLE_TOKEN_SECRET=""

# 8 horas por defecto.
TOKEN_TTL_SECONDS=28800

# Contraseña del administrador inicial. Obligatoria en producción cuando la base está vacía.
# Cámbiala después del primer arranque.
ADMIN_USERNAME="admin"
ADMIN_NAME="Administrador General"
ADMIN_PASSWORD=""

# true siembra carta, mesas y usuarios de demostración. Ponlo en false en producción real.
SEED_DEMO="true"

# Web Push (opcional). Genera claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:admin@gastro-os.local"
